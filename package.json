{
  "name": "qa-ch1",
  "version": "1.0.0",
  "description": "API test suite for the Cocos QA Challenge",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:off": "cross-env BUGS_TIER=off playwright test",
    "test:easy": "cross-env BUGS_TIER=easy playwright test",
    "test:medium": "cross-env BUGS_TIER=medium playwright test",
    "test:hard": "cross-env BUGS_TIER=hard playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:p0": "playwright test --grep @p0",
    "test:p1": "playwright test --grep @p1",
    "test:report": "playwright show-report",
    "test:allure": "npx allure generate allure-results --clean -o allure-report",
    "test:allure:open": "npx allure open allure-report",
    "test:allure:serve": "npx allure serve allure-results",
    "test:ui": "maestro test maestro/01-ars-to-qty.yaml maestro/02-buy-wiring.yaml maestro/03-reset.yaml",
    "test:postman": "newman run postman/cocos-api.postman_collection.json --environment postman/cocos-api.environment.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "ajv": "^8.20.0",
    "allure-playwright": "^3.0.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
