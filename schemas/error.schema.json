{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Error",
  "description": "Schema for error responses (4xx)",
  "type": "object",
  "required": ["error"],
  "properties": {
    "error": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable error message"
    }
  },
  "additionalProperties": true
}
