{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Portfolio",
  "description": "Schema for the portfolio object returned by GET /portfolio",
  "type": "object",
  "required": ["cash", "holdings"],
  "properties": {
    "cash": {
      "type": "number",
      "minimum": 0,
      "description": "Available cash balance in ARS"
    },
    "holdings": {
      "type": "array",
      "description": "List of current holdings",
      "items": {
        "type": "object",
        "required": ["instrument_id", "ticker", "quantity", "last_price", "close_price", "avg_cost_price"],
        "properties": {
          "instrument_id": {
            "type": "integer",
            "minimum": 1
          },
          "ticker": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "integer",
            "minimum": 0
          },
          "last_price": {
            "type": "number",
            "minimum": 0
          },
          "close_price": {
            "type": "number",
            "minimum": 0
          },
          "avg_cost_price": {
            "type": "number",
            "minimum": 0
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
