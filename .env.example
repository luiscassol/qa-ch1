# Base URL of the dummy API
API_BASE_URL=https://dummy-api-topaz.vercel.app

# Candidate ID: isolates your orders, cash, and holdings on the multi-tenant API.
# Required: must be a non-empty string unique to you.
CANDIDATE_ID=your-candidate-id

# Bug tier: off | easy | medium | hard
# off = golden path (expected behavior)
# easy/medium/hard = intentional API defects for QA coverage
# Defaults to off if not set or invalid.
BUGS_TIER=off
